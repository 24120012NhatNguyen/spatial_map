<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình dọc: thanh tìm kiếm + chip lọc + chú thích ở trên, sơ đồ ở giữa, Bottom Sheet ở dưới.
     focusableInTouchMode trên root: nhận focus khi ô tìm kiếm clearFocus (bàn phím đóng hẳn).
     splitMotionEvents=false: cử chỉ bắt đầu ở sơ đồ được giao trọn cho sơ đồ (ngón thứ hai đặt lên
     thành phần khác không làm pinch bị tách thành một lần chạm). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/floor"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:splitMotionEvents="false"
    tools:targetApi="o">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:menu="@menu/main_menu"
        app:subtitleTextColor="@color/on_surface_muted"
        app:titleTextColor="@color/on_surface" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:splitMotionEvents="false">

        <!-- Chừa đúng chiều cao Bottom Sheet thu gọn: sheet thu gọn không che sơ đồ. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/sheet_peek_height"
            android:orientation="vertical"
            android:splitMotionEvents="false">

            <include
                layout="@layout/view_search_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="8dp" />

            <HorizontalScrollView
                android:id="@+id/chip_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/filter_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    app:chipSpacingHorizontal="8dp"
                    app:singleLine="true">

                    <include layout="@layout/merge_filter_chips" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <com.example.cinemamap.ui.map.LegendView
                android:id="@+id/legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingBottom="6dp" />

            <FrameLayout
                android:id="@+id/map_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.example.cinemamap.ui.map.SeatMapView
                    android:id="@+id/seat_map"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/seat_map_description" />

                <include layout="@layout/view_no_results" />
            </FrameLayout>
        </LinearLayout>

        <include layout="@layout/view_selection_sheet" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
